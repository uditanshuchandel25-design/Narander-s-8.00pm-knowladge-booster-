# BM Daily Intel — Optional Configuration
# Copy this file to .env if you want to enable Gemini AI synthesis or change the port.

# Local server port (default: 8080)
PORT=8080

# Daily auto-refresh time in IST (24-hour format, default: 20:00 = 8:00 PM IST)
SCHEDULE_HOUR_IST=20
SCHEDULE_MINUTE_IST=0

# Optional: Add a Google Gemini API key to upgrade summaries from smart rule-based
# extraction to full AI Senior Researcher executive synthesis.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
